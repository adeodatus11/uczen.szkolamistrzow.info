---
import ArticleCard from "@components/ArticleCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { articles } from "@data/articles";

const sorted = [...articles].sort((first, second) => second.publishedAt.localeCompare(first.publishedAt));
---

<BaseLayout
  title="Aktualności | Strefa Ucznia ZSZ5"
  description="Aktualności dla uczniów, rodziców i opiekunów ZSZ5: wyjaśnienia szkolnych zasad oraz wsparcie, z którego można skorzystać."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Dla uczniów, rodziców i opiekunów</p>
      <h1>Aktualności</h1>
      <p class="lead">Piszemy o tym, dlaczego wprowadzamy określone zasady, i podajemy dalej informacje o wsparciu, z którego można skorzystać. Prosto, bez moralizowania, ze wskazaniem źródeł, do których można zajrzeć samodzielnie.</p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="article-grid">
        {sorted.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
</BaseLayout>
