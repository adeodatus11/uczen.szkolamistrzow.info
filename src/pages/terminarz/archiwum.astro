---
import { ArrowLeft } from "lucide-astro";
import EventTimeline from "@components/EventTimeline.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { archivedEvents, schoolYear } from "@data/calendar";
import { sitePath } from "../../lib/paths";

const archived = archivedEvents();
---

<BaseLayout
  title={`Archiwum terminarza ${schoolYear} | Strefa Ucznia ZSZ5`}
  description="Archiwum terminów ZSZ5 z roku szkolnego 2026/2027: terminy dokumentów, rozpoczęcie roku i zebrania, które już się odbyły."
>
  <section class="page-hero">
    <div class="container">
      <a class="text-link" href={sitePath("/terminarz/")}><ArrowLeft size={18} aria-hidden="true" /> Wróć do terminarza</a>
      <p class="eyebrow">Rok szkolny {schoolYear}</p>
      <h1>Archiwum terminów</h1>
      <p class="lead">Terminy, które już minęły. Zapisujemy je, żeby można było sprawdzić, co i kiedy szkoła ogłaszała. Aktualne terminy znajdziesz w terminarzu.</p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      {archived.length === 0
        ? <p class="notice-empty">Żaden zapisany termin jeszcze nie minął.</p>
        : <EventTimeline events={archived} past />}
    </div>
  </section>
</BaseLayout>
