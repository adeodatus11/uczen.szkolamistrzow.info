---
import {
  ArrowDown,
  ArrowRight,
  BookCheck,
  CheckCircle2,
  ExternalLink,
  FileText,
  GraduationCap,
  LibraryBig,
  ShoppingCart,
} from "lucide-astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import SourceLinks from "@components/SourceLinks.astro";
import { textbookDocuments } from "@data/textbooks";
import { sitePath } from "../lib/paths";

const vocationalSchool = textbookDocuments.find((document) => document.id === "branzowa")!;
const technical = textbookDocuments.find((document) => document.id === "technikum")!;
---

<BaseLayout title="Podręczniki 2026/2027 | Strefa Ucznia ZSZ5" description="Aktualne wykazy podręczników ZSZ5 dla Branżowej Szkoły I stopnia i Technikum nr 5, uporządkowane według zawodów, kierunków i klas.">
  <section class="page-hero textbook-hero">
    <div class="container hero-layout">
      <div>
        <p class="eyebrow">Aktualne wykazy ZSZ5 · rok szkolny 2026/2027</p>
        <h1>Podręczniki</h1>
        <p class="lead">Najpierw wybierz typ szkoły oraz zawód lub kierunek kształcenia. Następnie w oficjalnym wykazie znajdź swoją klasę i sprawdź wszystkie uwagi przy danym przedmiocie.</p>
      </div>
      <aside class="publication-card" aria-label="Status wykazów">
        <BookCheck size={30} aria-hidden="true" />
        <span>Wykazy opublikowane</span>
        <strong>Rok szkolny 2026/2027</strong>
        <small>Sprawdzone 4 sierpnia 2026 r.</small>
      </aside>
    </div>
  </section>

  <nav class="school-picker" aria-label="Wybierz typ szkoły">
    <div class="container school-picker-inner">
      <span>Przejdź do wykazu:</span>
      <a href="#branzowa">Branżowa Szkoła I stopnia <ArrowDown size={17} aria-hidden="true" /></a>
      <a href="#technikum">Technikum <ArrowDown size={17} aria-hidden="true" /></a>
    </div>
  </nav>

  <section class="band band-soft" aria-labelledby="before-download">
    <div class="container two-column-info">
      <div>
        <p class="eyebrow">Zanim otworzysz wykaz</p>
        <h2 id="before-download">Trzy informacje, których potrzebujesz</h2>
        <ol class="decision-steps">
          <li><span>1</span><div><strong>Typ szkoły</strong><p>Branżowa Szkoła I stopnia albo Technikum.</p></div></li>
          <li><span>2</span><div><strong>Zawód lub kierunek</strong><p>Na przykład fryzjer, sprzedawca albo technik handlowiec.</p></div></li>
          <li><span>3</span><div><strong>Klasa</strong><p>Ten sam przedmiot może mieć inną część podręcznika w klasie 1, 2 lub 3.</p></div></li>
        </ol>
      </div>
      <aside class="library-note">
        <LibraryBig size={28} aria-hidden="true" />
        <h3>Nie kupuj wszystkich książek od razu</h3>
        <p>Wiele podręczników może być dostępnych w bibliotece szkolnej. Niektóre będą zamawiane grupowo przez nauczyciela na początku roku.</p>
      </aside>
    </div>
  </section>

  <section class="band textbook-section bs-section" id="branzowa" aria-labelledby="branzowa-heading">
    <div class="container">
      <div class="document-heading">
        <div>
          <p class="eyebrow">{vocationalSchool.audience}</p>
          <h2 id="branzowa-heading">{vocationalSchool.title}</h2>
          <p>{vocationalSchool.description}</p>
        </div>
        <a class="document-link" href={vocationalSchool.href} target="_blank" rel="noreferrer">
          <FileText size={25} aria-hidden="true" />
          <span><strong>Otwórz oficjalny wykaz</strong><small>PDF · {vocationalSchool.fileSize} · {vocationalSchool.pages} strony</small></span>
          <ExternalLink size={19} aria-hidden="true" />
        </a>
      </div>

      <div class="programme-list">
        {vocationalSchool.programmes.map((programme) => (
          <article class="programme-row">
            <div class="programme-name">
              <h3>{programme.name}</h3>
              <span>{programme.classes}</span>
            </div>
            <div>
              <p>{programme.description}</p>
              {programme.notice && <p class="order-notice"><ShoppingCart size={18} aria-hidden="true" /> <strong>{programme.notice}</strong></p>}
            </div>
          </article>
        ))}
      </div>

      <a class="text-link guide-link" href={sitePath("/branzowa/")}>Przejdź do przewodnika ucznia Branżowej Szkoły I stopnia <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </section>

  <section class="band band-soft textbook-section t5-section" id="technikum" aria-labelledby="technikum-heading">
    <div class="container">
      <div class="document-heading">
        <div>
          <p class="eyebrow">{technical.audience}</p>
          <h2 id="technikum-heading">{technical.title}</h2>
          <p>{technical.description}</p>
        </div>
        <a class="document-link" href={technical.href} target="_blank" rel="noreferrer">
          <FileText size={25} aria-hidden="true" />
          <span><strong>Otwórz oficjalny wykaz</strong><small>PDF · {technical.fileSize} · {technical.pages} stron</small></span>
          <ExternalLink size={19} aria-hidden="true" />
        </a>
      </div>

      <div class="programme-list">
        {technical.programmes.map((programme) => (
          <article class="programme-row">
            <div class="programme-name">
              <h3>{programme.name}</h3>
              <span>{programme.classes}</span>
            </div>
            <div>
              <p>{programme.description}</p>
              {programme.notice && <p class="order-notice"><ShoppingCart size={18} aria-hidden="true" /> <strong>{programme.notice}</strong></p>}
            </div>
          </article>
        ))}
      </div>

      <a class="text-link guide-link" href={sitePath("/technikum/")}>Przejdź do przewodnika ucznia Technikum nr 5 <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </section>

  <section class="band" aria-labelledby="buy-correctly">
    <div class="container purchase-layout">
      <div>
        <p class="eyebrow">Kontrola przed zakupem</p>
        <h2 id="buy-correctly">Jak sprawdzić, czy to właściwa książka</h2>
        <p>Sam tytuł nie zawsze wystarczy. W ramach jednej serii mogą występować różne części, poziomy i wydania.</p>
      </div>
      <ul class="purchase-checklist">
        <li><CheckCircle2 size={21} aria-hidden="true" /><span>rok szkolny <strong>2026/2027</strong></span></li>
        <li><CheckCircle2 size={21} aria-hidden="true" /><span>właściwy <strong>typ szkoły i zawód</strong></span></li>
        <li><CheckCircle2 size={21} aria-hidden="true" /><span>właściwa <strong>klasa, część i zakres</strong></span></li>
        <li><CheckCircle2 size={21} aria-hidden="true" /><span>zgodne dane: <strong>autorzy i wydawnictwo</strong></span></li>
        <li><CheckCircle2 size={21} aria-hidden="true" /><span>zgodny <strong>numer dopuszczenia</strong>, jeżeli go podano</span></li>
      </ul>
    </div>
  </section>

  <section class="band band-soft">
    <div class="container compact-section">
      <div class="callout">
        <GraduationCap size={27} aria-hidden="true" />
        <div>
          <h2>Wykaz PDF jest dokumentem nadrzędnym</h2>
          <p>Podział według zawodów na tej stronie ułatwia znalezienie właściwego pliku. Pełne tytuły, autorów, części, wydawnictwa i numery dopuszczenia należy zawsze sprawdzić w oficjalnym wykazie szkoły.</p>
          <div class="button-row">
            <a class="button secondary" href="https://zsz5.edupage.org/a/podreczniki" target="_blank" rel="noreferrer">Strona podręczników w EduPage <ExternalLink size={18} aria-hidden="true" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div id="sources">
    <SourceLinks ids={["zsz5-textbooks-2026", "statut-zsz5"]} />
  </div>
</BaseLayout>

<style>
  .textbook-hero {
    background: linear-gradient(110deg, var(--green-soft) 0 58%, var(--blue-soft) 58% 100%);
  }

  .hero-layout,
  .document-heading,
  .purchase-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.45fr);
    gap: 48px;
    align-items: center;
  }

  .publication-card {
    border-left: 5px solid var(--green);
    background: var(--paper);
    padding: 24px;
    box-shadow: var(--shadow);
  }

  .publication-card svg,
  .publication-card span,
  .publication-card strong,
  .publication-card small {
    display: block;
  }

  .publication-card svg {
    margin-bottom: 16px;
    color: var(--green-dark);
  }

  .publication-card span,
  .publication-card small {
    color: var(--muted);
  }

  .publication-card span {
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .publication-card strong {
    margin: 3px 0 8px;
    font-size: 1.25rem;
  }

  .school-picker {
    position: sticky;
    z-index: 20;
    top: 108px;
    border-block: 1px solid var(--line);
    background: var(--paper);
  }

  .school-picker-inner {
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .school-picker-inner > span {
    margin-right: auto;
    color: var(--muted);
    font-weight: 750;
  }

  .school-picker a {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-bottom: 3px solid var(--green);
    padding: 7px 4px;
    font-weight: 800;
    text-decoration: none;
  }

  .school-picker a:last-child {
    border-bottom-color: var(--blue);
  }

  .decision-steps {
    display: grid;
    gap: 18px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .decision-steps li {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 14px;
  }

  .decision-steps li > span {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-weight: 850;
  }

  .decision-steps p {
    margin: 2px 0 0;
    color: var(--muted);
  }

  .textbook-section {
    scroll-margin-top: 178px;
  }

  .document-heading {
    align-items: end;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }

  .document-heading > div > p:last-child {
    max-width: 68ch;
    margin-top: 12px;
    color: var(--muted);
  }

  .document-link {
    min-height: 88px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    border: 1px solid var(--line);
    border-left: 5px solid var(--green);
    border-radius: 8px;
    background: var(--paper);
    padding: 16px 18px;
    text-decoration: none;
  }

  .t5-section .document-link {
    border-left-color: var(--blue);
  }

  .document-link:hover {
    box-shadow: var(--shadow);
  }

  .document-link span,
  .document-link strong,
  .document-link small {
    display: block;
  }

  .document-link small {
    margin-top: 3px;
    color: var(--muted);
  }

  .programme-list {
    margin-top: 10px;
  }

  .programme-row {
    display: grid;
    grid-template-columns: minmax(220px, 0.34fr) minmax(0, 1fr);
    gap: 36px;
    border-bottom: 1px solid var(--line);
    padding: 23px 0;
  }

  .programme-name h3,
  .programme-name span {
    display: block;
  }

  .programme-name h3 {
    font-size: 1.08rem;
  }

  .programme-name span {
    margin-top: 3px;
    color: var(--green-dark);
    font-size: 0.83rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .t5-section .programme-name span {
    color: var(--blue-dark);
  }

  .programme-row p {
    margin: 0;
  }

  .order-notice {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    margin-top: 13px !important;
    border-left: 4px solid var(--yellow);
    background: var(--yellow-soft);
    padding: 12px 14px;
  }

  .order-notice svg {
    flex: 0 0 auto;
    margin-top: 3px;
    color: var(--yellow);
  }

  .guide-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font-weight: 800;
    text-decoration: none;
  }

  .purchase-layout {
    align-items: start;
  }

  .purchase-layout > div > p:last-child {
    margin-top: 12px;
    color: var(--muted);
  }

  .purchase-checklist {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .purchase-checklist li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    border-bottom: 1px solid var(--line);
    padding: 0 0 11px;
  }

  .purchase-checklist svg {
    margin-top: 3px;
    color: var(--green-dark);
  }

  @media (max-width: 980px) {
    .hero-layout,
    .document-heading,
    .purchase-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .school-picker {
      top: 82px;
    }

    .textbook-section {
      scroll-margin-top: 152px;
    }
  }

  @media (max-width: 680px) {
    .textbook-hero {
      background: var(--green-soft);
    }

    .school-picker {
      position: static;
    }

    .school-picker-inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
      padding-block: 13px;
    }

    .school-picker-inner > span {
      margin: 0 0 4px;
    }

    .school-picker a {
      justify-content: space-between;
    }

    .textbook-section {
      scroll-margin-top: 82px;
    }

    .programme-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .document-link {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .document-link > svg:last-child {
      display: none;
    }
  }
</style>
