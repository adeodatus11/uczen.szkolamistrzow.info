---
import { ArrowRight, CalendarPlus, CalendarRange, Clock3 } from "lucide-astro";
import { upcomingEvents, type EventScope } from "@data/calendar";
import { dayNumber, eventTimeLabel, fullDate, monthAndYear } from "../lib/eventDate";
import { sitePath } from "../lib/paths";

type Props = {
  scope?: EventScope;
  limit?: number;
};

const { scope = "all", limit } = Astro.props;
const all = upcomingEvents(scope);
const events = limit ? all.slice(0, limit) : all;
---

{events.length === 0 ? (
  <p class="notice-empty">Wszystkie zapisane terminy już minęły. Zajrzyj do <a href={sitePath("/terminarz/archiwum/")}>archiwum terminarza</a>.</p>
) : (
  <div class="notice-grid">
    {events.map((event) => (
      <article class:list={["notice-card", `tone-${event.tone}`]}>
        <div class="notice-date">
          <strong>{dayNumber(event.date)}</strong>
          <span>{monthAndYear(event.date)}</span>
          {event.endDate
            ? <small><CalendarRange size={16} aria-hidden="true" /> do {fullDate(event.endDate)}</small>
            : eventTimeLabel(event) && <small><Clock3 size={16} aria-hidden="true" /> {eventTimeLabel(event)}</small>}
        </div>
        <div class="notice-content">
          <p class="audience-label">{event.audience}</p>
          <h3>{event.title}</h3>
          <p>{event.description}</p>
          {event.action && <strong class="notice-action">{event.action}</strong>}
          <div class="notice-links">
            {event.href && <a class="text-link" href={sitePath(event.href)}>Pełna informacja <ArrowRight size={17} aria-hidden="true" /></a>}
            <a class="text-link subtle" href={sitePath(`/terminarz/${event.id}.ics`)} download>Dodaj do kalendarza <CalendarPlus size={17} aria-hidden="true" /></a>
          </div>
        </div>
      </article>
    ))}
  </div>
)}
